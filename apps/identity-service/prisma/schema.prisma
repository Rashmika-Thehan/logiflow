generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("IDENTITY_DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  BUSINESS_ADMIN
  DISPATCHER
  DRIVER
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  users     User[]
  branches  Branch[]
  apiKeys   ApiKey[]
  joinCode     String?       @unique // null = join requests disabled (the default)
  invitations  Invitation[]
  joinRequests JoinRequest[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  role         Role
  fullName     String?
  phone        String?
  createdAt    DateTime @default(now())
}

model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  address   String
  latitude  Float?
  longitude Float?
  phone     String?
  createdAt DateTime @default(now())
}

model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  name       String
  keyPrefix  String    // first 8 hex chars of the raw key — safe to log/display, used to narrow lookup candidates
  keyHash    String    // bcrypt hash of the full raw key — the raw key itself is never stored
  scopes     String[]
  allowedIps String[]  // empty array = unrestricted
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

model Invitation {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  email       String
  role        Role
  tokenHash   String    @unique // SHA-256 of the raw token; the raw token is never stored
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, email])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model JoinRequest {
  id              String            @id @default(uuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  email           String
  fullName        String
  phone           String
  passwordHash    String?           // cleared as soon as the request is resolved
  requestedRole   Role              // a hint only; the admin decides at approval
  status          JoinRequestStatus @default(PENDING)
  resolvedRole    Role?
  resolvedById    String?
  resolvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime          @default(now())

  @@index([tenantId, status])
  @@index([email])
}