{{#> layout title="You're invited to LogiFlow"}}

  <!-- ─── GREETING ───────────────────────────────────── -->
  <p style="margin:0 0 8px;font-size:26px;font-weight:700;color:#0f172a;line-height:1.25;">
    You're invited! &#127881;
  </p>
  <p style="margin:0 0 28px;font-size:15px;color:#64748b;line-height:1.6;">
    <strong>{{inviterName}}</strong> has invited you to join <strong>{{organizationName}}</strong> on LogiFlow
    as a <strong>{{roleLabel}}</strong>.
  </p>

  <!-- ─── INVITE CARD ───────────────────────────────── -->
  <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;margin-bottom:28px;">
    <tr>
      <td style="background:linear-gradient(135deg,#1e3a5f 0%,#1d4ed8 100%);border-radius:12px;padding:28px 24px;text-align:center;">
        <p style="margin:0 0 6px;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:1.2px;color:#93c5fd;">
          Your Role
        </p>
        <p style="margin:0 0 20px;font-size:28px;font-weight:800;color:#ffffff;line-height:1.1;">
          {{roleLabel}}
        </p>
        <a href="{{acceptUrl}}"
          style="display:inline-block;background-color:#3b82f6;color:#ffffff;font-size:14px;font-weight:700;text-decoration:none;border-radius:8px;padding:12px 28px;letter-spacing:0.3px;">
          &#10003; Accept Invitation
        </a>
        {{#if expiresAtText}}
        <p style="margin:16px 0 0;font-size:12px;color:#bfdbfe;line-height:1.6;">
          This invitation expires on {{expiresAtText}}.
        </p>
        {{/if}}
      </td>
    </tr>
  </table>

  <!-- ─── ORGANIZATION DETAILS ─────────────────────── -->
  <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;margin-bottom:28px;">
    <tr>
      <td style="background-color:#f0f9ff;border:1px solid #bae6fd;border-radius:10px;padding:20px 24px;">
        <p style="margin:0 0 4px;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.8px;color:#0369a1;">
          Organization
        </p>
        <p style="margin:0 0 14px;font-size:18px;font-weight:700;color:#0c4a6e;">
          {{organizationName}}
        </p>
        <p style="margin:0;font-size:13px;color:#0369a1;line-height:1.6;">
          Invited by <strong>{{inviterName}}</strong>
        </p>
      </td>
    </tr>
  </table>

  <!-- ─── SECURITY NOTICE ───────────────────────────── -->
  <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;margin-bottom:8px;">
    <tr>
      <td style="background-color:#fefce8;border:1px solid #fde047;border-radius:8px;padding:14px 18px;">
        <p style="margin:0;font-size:13px;color:#713f12;line-height:1.6;">
          &#9888;&#65039; <strong>Security tip:</strong> Don't forward this email &mdash; anyone with the link can
          accept the invitation on your behalf. If you weren't expecting this, you can safely ignore it.
        </p>
      </td>
    </tr>
  </table>

{{/layout}}