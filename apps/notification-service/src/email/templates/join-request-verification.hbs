{{#> layout title="Verify your email"}}
  <p>Hi {{greeting}},</p>
  <p>Use this code to verify your email address for your request to join <strong>{{organizationName}}</strong>:</p>
  <p style="font-size:32px;letter-spacing:6px;font-weight:bold;margin:8px 0">{{code}}</p>
  <p style="color:#666">The code expires in 15 minutes. If you didn't make this request, you can ignore this email.</p>
{{/layout}}